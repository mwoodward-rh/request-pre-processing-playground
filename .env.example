# Copy to .env or export in your shell. Shell > .env > defaults.
# Only scripts/setup.py and scripts/launch.py load .env. No shell evaluation.
# These are SERVER settings; never use VITE_ keys.
JEV_MODE=local
JEV_URL=http://127.0.0.1:8022
JEV_MODEL=com-kotobalabs/open-jev-deberta-v3-large
JEV_MODEL_PATH=models/open-jev
JEV_DEVICE=cpu
# Download the matching tokenizer ahead of time, or use a local tokenizer.json.
JEV_TOKENIZER=models/open-jev/tokenizer.json
# Remote OpenAI-compatible Chat Completions endpoint. Keep the key server-side.
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Optional Ollama: select ollama and set EXTRACTION_MODEL to an installed model tag.
EXTRACTION_URL=http://127.0.0.1:11434
# For Azure Foundry, select EXTRACTION_PROVIDER=foundry and provide the Responses endpoint.
FOUNDRY_ENDPOINT=
FOUNDRY_API_VERSION=2025-11-15-preview
LAB_PORT=8030
OLLAMA_AUTOSTART=1
# Remote OpenAI endpoints must use HTTPS. HTTP is allowed only for a loopback endpoint.
